# ttobagi-server 환경변수 템플릿
#
# 이 파일을 복사해 .env 를 만들고 실제 값을 채워 넣습니다.
#   cp .env.example .env
#
# .env 는 절대 커밋하지 않습니다. (.gitignore 등록됨)

# --- 실행 프로파일 ---
# 비워두면 local 로 실행됩니다. 배포 서버에서는 prod 로 지정합니다.
# SPRING_PROFILES_ACTIVE=local

# --- DB (MariaDB) ---
# 예: jdbc:mariadb://localhost:3306/ttobagi_db
# 사용자명에 root 는 쓸 수 없습니다. (docker compose 가 일반 계정으로 생성)
TTOBAGI_DB_URL=
TTOBAGI_DB_USERNAME=
TTOBAGI_DB_PASSWORD=

# --- 로컬 MariaDB 컨테이너 (docker compose 전용) ---
# root 계정 비밀번호
TTOBAGI_DB_ROOT_PASSWORD=
# 호스트에 노출할 포트. 비워두면 3306, 바꾸면 TTOBAGI_DB_URL 의 포트도 맞춥니다.
# TTOBAGI_DB_PORT=3306

# --- AI 서버 ---
# FastAPI 분석 서버 주소. 예: http://localhost:8000
TTOBAGI_AI_SERVER=
# AI 서버와 같은 값을 써야 합니다. 생성 예시: openssl rand -hex 32
# BE → AI 요청에 붙이는 토큰
TTOBAGI_AI_API_TOKEN=
# AI → BE 분석 결과 콜백에서 확인하는 토큰
TTOBAGI_CALLBACK_TOKEN=

# --- 원본 보관 (NCP Object Storage) ---
# true로 하면 업로드 원본을 버킷에 보관합니다. 로컬은 false로 둡니다.
# 키는 Object Storage 권한만 있는 Sub Account의 API 인증키를 씁니다.
TTOBAGI_STORAGE_ENABLED=false
TTOBAGI_STORAGE_ACCESS_KEY=
TTOBAGI_STORAGE_SECRET_KEY=
TTOBAGI_STORAGE_UPLOAD_BUCKET=breathai-uploads
# DB 백업 업로드용 (deploy/backup 스크립트가 사용)
TTOBAGI_STORAGE_BACKUP_BUCKET=breathai-backup

# --- JWT ---
# HS256 서명 키. 최소 32바이트 이상의 랜덤 문자열
# 생성 예시: openssl rand -hex 32
JWT_SECRET=

# --- 메일 (Gmail SMTP) ---
# 비밀번호 재설정 메일 발송용. 앱 비밀번호를 사용합니다.
MAIL_USERNAME=
MAIL_PASSWORD=

# --- 관리자 ---
# 회원가입 시 이 코드를 입력하면 ADMIN 권한이 부여됩니다.
SYSTEM_ADMIN_CODE=
# 공사 메일(@seoulmetro.co.kr) 외에 가입·로그인을 허용할 주소. 여러 개면 쉼표로 구분, 비우면 공사 메일만
# 예: someone@example.com,other@example.org
TTOBAGI_EXTRA_ALLOWED_EMAILS=

# --- CORS ---
# 허용할 프론트엔드 주소. 여러 개면 쉼표로 구분
# 예: http://localhost:5173,https://ttobagi.example.com
CORS_ALLOWED_ORIGINS=

# --- Swagger ---
SWAGGER_CONTACT_NAME=
SWAGGER_CONTACT_EMAIL=
SWAGGER_PRODUCTION_URL=
