# API and worker: same persistent root; local filesystem, one worker per GPU.
TTOBAGI_JOB_ROOT=/data/jobs
# BE -> AI: configure the same value on both sides.
TTOBAGI_AI_API_TOKEN=
# AI -> BE: configure the same value on both sides.
TTOBAGI_CALLBACK_TOKEN=
TTOBAGI_BE_BASE_URL=https://backend.example.com
# BE setting: actual external Vast.ai endpoint or private tunnel endpoint.
TTOBAGI_AI_SERVER=https://ai.example.com
# FAQ sources and existing DB_* settings are also required by inference.
TTOBAGI_GENERAL_FAQ_PATH=/data/sources/일반상담.xlsx
TTOBAGI_COUNSELLING_FAQ_PATH=/data/sources/counselling_info.csv
# Existing inference DB configuration: approved FAQ reads still require DB access.
DB_HOST=
DB_PORT=3306
DB_NAME=ttobagi_db
DB_USER=
DB_PASSWORD=
# Compose variables (used for substitution via --env-file .env.ai).
# Use an absolute directory containing FAQ source files.
AI_SOURCE_DIR=/absolute/path/to/faq-sources
AI_BIND_ADDRESS=127.0.0.1
AI_PORT=8000

# Built with Llama. Accept the Meta license and obtain model access separately.
TTOBAGI_LLM_MODEL=meta-llama/Llama-3.1-8B-Instruct
# Set immutable Hugging Face commit hashes for reproducible deployments.
TTOBAGI_LLM_REVISION=
# Runtime Judge; formal model comparisons require a fixed independent Judge.
TTOBAGI_JUDGE_MODEL=meta-llama/Llama-3.1-8B-Instruct
TTOBAGI_JUDGE_REVISION=
TTOBAGI_LLM_QUANTIZATION=none
# For constrained local GPUs only: allow unquantized CPU modules with a GPU budget.
TTOBAGI_LLM_CPU_OFFLOAD=false
# Optional Llama 3.1 layout for a small GPU. Explicit placement overrides auto placement.
# TTOBAGI_LLM_DEVICE_MAP={"model.embed_tokens":"cpu","model.layers":0,"model.norm":0,"lm_head":"cpu"}
# Optional on small local GPUs: run the unchanged Cross-Encoder on CPU.
# TTOBAGI_CE_DEVICE=cpu
TTOBAGI_LLM_CONTEXT_TOKENS=8192
# Read-only gated model token. Never commit a populated .env.ai.
HF_TOKEN=
